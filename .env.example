# Primary Alchemy API Key
ALCHEMY_KEY=your_alchemy_key_here

# Arbitrum One (Chain ID 42161)
ARBITRUM_RPC_WS=wss://arb-mainnet.g.alchemy.com/v2/your_alchemy_key_here
ARBITRUM_RPC_HTTP=https://arb-mainnet.g.alchemy.com/v2/your_alchemy_key_here
ARBITRUM_SEQUENCER_FEED=wss://arb1-feed.arbitrum.io/feed

# Base (Chain ID 8453)
BASE_RPC_WS=wss://base-mainnet.g.alchemy.com/v2/your_alchemy_key_here
BASE_RPC_HTTP=https://base-mainnet.g.alchemy.com/v2/your_alchemy_key_here
BASE_FLASHBLOCKS_WS=wss://base-mainnet.g.alchemy.com/v2/your_alchemy_key_here

# Runtime Operation Mode (shadow | live)
EXECUTION_MODE=shadow
LOG_LEVEL=info

# Multi-EOA Signers (comma-separated hex keys)
SIGNER_PRIVATE_KEYS=your_private_key_here

# Vanity Contract Address
EXECUTOR_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Cache and Graph Settings
CACACHE_DIR=./cacache
MAX_HOPS=3
KILL_SWITCH_FEED_LAG_MS=100
KILL_SWITCH_FAST_REVERT_COUNT=3
